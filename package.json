{
  "name": "drift-browser",
  "productName": "Drift",
  "version": "0.9.2",
  "description": "A Chromium-based browser with vertical tabs, spaces and split view, in the style of Zen.",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "update-engine": "node scripts/update-engine.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "icons": "node scripts/build-icons.mjs",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "app.drift.browser",
    "productName": "Drift",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "Drift"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dor2500",
        "repo": "drift-browser",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/png/icon-1024.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/png",
      "category": "Network;WebBrowser",
      "maintainer": "dor2500"
    },
    "protocols": [
      {
        "name": "Drift engine switch",
        "schemes": [
          "drift-engine"
        ]
      }
    ]
  },
  "author": {
    "name": "dor2500",
    "email": "dor2500a@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dor2500/drift-browser.git"
  },
  "homepage": "https://github.com/dor2500/drift-browser"
}
